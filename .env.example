# ─── SvelteKit (build-time, set in Vercel → Project Settings → Environment Variables) ──
# Get these from: Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Auth gating toggles (independent — set only the ones you want live) ───────
# VITE_AUTH_GATING_ENABLED=true      → require Google sign-in on Sales + Rental pages
# VITE_INVESTOR_GATING_ENABLED=true  → require Google sign-in on the Investors tab
# VITE_INVESTOR_PRO_GATED=true       → (only if Investors gating is on) also require
#                                       an active Pro subscription, not just sign-in
# VITE_STAN_STORE_URL=https://...    → checkout link shown on "Upgrade to Pro" CTAs

# ─── Supabase Edge Functions (set via `supabase secrets set`) ──────────────────
# These are injected automatically by Supabase — you do NOT need to set them manually:
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY
#   SUPABASE_ANON_KEY

# These you DO need to set via `supabase secrets set`:
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Format: whatsapp:+14155238886  (sandbox number) or whatsapp:+your_approved_number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
